{
  "rules": {
    ".read": false,
    ".write": false,
    "idx": {
      ".read": "auth != null",
      ".indexOn": ["t"],
      "$lid": {
        ".write": "auth != null && ((!data.exists() && newData.parent().parent().child('lob/' + $lid + '/m').exists()) || (!newData.exists() && !root.child('lob/' + $lid + '/s').exists()))",
        ".validate": "$lid.matches(/^L[A-Za-z0-9]{8}$/) && newData.hasChildren(['n', 'r', 't'])",
        "n": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 24" },
        "r": { ".validate": "newData.isString() && newData.val().length <= 6" },
        "t": { ".validate": "newData.isNumber() && newData.val() <= now" },
        "$other": { ".validate": false }
      }
    },
    "lob": {
      "$lid": {
        ".read": "auth != null",
        ".write": "auth != null && !newData.exists() && !data.child('s').exists()",
        "m": {
          ".write": "auth != null && !data.exists() && newData.parent().child('s').exists()",
          ".validate": "$lid.matches(/^(L[A-Za-z0-9]{8}|P[A-Z0-9]{6})$/) && newData.hasChildren(['n', 'r', 'pub', 't'])",
          "n": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 24" },
          "r": { ".validate": "newData.isString() && newData.val().length <= 6" },
          "pub": { ".validate": "newData.isBoolean()" },
          "t": { ".validate": "newData.isNumber() && newData.val() <= now" },
          "$other": { ".validate": false }
        },
        "s": {
          "$slot": {
            ".write": "auth != null && ((!data.exists() && newData.val() === auth.uid && newData.parent().parent().child('u/' + auth.uid).val() === $slot && newData.parent().parent().child('m').exists()) || (data.exists() && !newData.exists() && (data.val() === auth.uid || newData.parent().parent().child('u/' + data.val()).val() !== $slot || !newData.parent().parent().child('p/' + data.val() + '/hb').exists() || newData.parent().parent().child('p/' + data.val() + '/hb').val() < now - 90000)))",
            ".validate": "$slot.matches(/^([0-9]|1[0-5])$/) && newData.isString() && newData.val() === auth.uid"
          }
        },
        "u": {
          "$uid": {
            ".write": "auth != null && ($uid === auth.uid || (!newData.exists() && (!root.child('lob/' + $lid + '/p/' + $uid + '/hb').exists() || root.child('lob/' + $lid + '/p/' + $uid + '/hb').val() < now - 90000)))",
            ".validate": "newData.isString() && newData.parent().parent().child('s/' + newData.val()).val() === auth.uid"
          }
        },
        "p": {
          "$uid": {
            ".write": "auth != null && (($uid === auth.uid && (!newData.exists() || newData.parent().parent().child('s/' + newData.parent().parent().child('u/' + auth.uid).val()).val() === auth.uid)) || (!newData.exists() && data.child('hb').val() < now - 90000))",
            ".validate": "newData.hasChildren(['n', 'l', 'hb', 'j'])",
            "n": { ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 16" },
            "l": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 999" },
            "h": { ".validate": "newData.isString() && newData.val().length <= 10" },
            "c": { ".validate": "newData.isString() && newData.val().length <= 60" },
            "g": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 20" },
            "rg": { ".validate": "newData.isNumber() && newData.val() >= 100 && newData.val() <= 2000" },
            "cr": { ".validate": "newData.isString() && newData.val().length <= 40" },
            "cn": { ".validate": "newData.isString() && newData.val().length <= 20" },
            "b": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000000" },
            "k": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000" },
            "xy": { ".validate": "newData.isString() && newData.val().length <= 24" },
            "hb": { ".validate": "newData.isNumber() && newData.val() <= now" },
            "j": { ".validate": "newData.isNumber() && newData.val() <= now" },
            "$other": { ".validate": false }
          }
        },
        "c": {
          "$cell": {
            "$uid": {
              ".write": "auth != null && (($uid === auth.uid && (!newData.exists() || newData.parent().parent().parent().child('p/' + auth.uid).exists())) || (!newData.exists() && (!root.child('lob/' + $lid + '/p/' + $uid).exists() || root.child('lob/' + $lid + '/p/' + $uid + '/hb').val() < now - 90000)))",
              ".validate": "newData.isString() && newData.val().length <= 80 && $cell.matches(/^[0-9]{1,2}_[0-9]{1,2}$/)"
            }
          }
        },
        "ch": {
          "$mid": {
            ".write": "auth != null && ((!data.exists() && newData.child('u').val() === auth.uid && root.child('lob/' + $lid + '/p/' + auth.uid).exists() && newData.parent().parent().child('rl/' + auth.uid).val() === now) || (!newData.exists() && (data.child('u').val() === auth.uid || data.child('t').val() < now - 600000)))",
            ".validate": "newData.hasChildren(['u', 'n', 't'])",
            "u": { ".validate": "newData.isString()" },
            "n": { ".validate": "newData.isString() && newData.val().length <= 16" },
            "m": { ".validate": "newData.isString() && newData.val().length <= 120" },
            "e": { ".validate": "newData.isString() && newData.val().length <= 12" },
            "t": { ".validate": "newData.val() === now" },
            "$other": { ".validate": false }
          }
        },
        "rl": {
          "$uid": {
            ".write": "auth != null && $uid === auth.uid",
            ".validate": "newData.isNumber() && newData.val() === now && (!data.exists() || data.val() <= now - 1200)"
          }
        },
        "ev": {
          "$victim": {
            ".write": "auth != null && $victim === auth.uid && !newData.exists()",
            "$eid": {
              ".write": "auth != null && ((!data.exists() && $victim !== auth.uid && newData.child('a').val() === auth.uid && root.child('lob/' + $lid + '/p/' + auth.uid).exists() && root.child('lob/' + $lid + '/p/' + $victim).exists() && newData.parent().parent().parent().child('hr/' + auth.uid).val() === now) || (!newData.exists() && $victim === auth.uid))",
              ".validate": "newData.hasChildren(['a', 'd', 't'])",
              "a": { ".validate": "newData.isString()" },
              "d": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 400" },
              "k": { ".validate": "newData.isString() && newData.val().length <= 4" },
              "t": { ".validate": "newData.val() === now" },
              "$other": { ".validate": false }
            }
          }
        },
        "hr": {
          "$uid": {
            ".write": "auth != null && $uid === auth.uid",
            ".validate": "newData.isNumber() && newData.val() === now && (!data.exists() || data.val() <= now - 150)"
          }
        },
        "k": {
          "$kid": {
            ".write": "auth != null && ((!data.exists() && newData.child('v').val() === auth.uid && root.child('lob/' + $lid + '/p/' + auth.uid).exists()) || (!newData.exists() && data.child('t').val() < now - 300000))",
            ".validate": "newData.hasChildren(['a', 'v', 'b', 't'])",
            "a": { ".validate": "newData.isString() && newData.val().length <= 40" },
            "v": { ".validate": "newData.isString()" },
            "an": { ".validate": "newData.isString() && newData.val().length <= 16" },
            "vn": { ".validate": "newData.isString() && newData.val().length <= 16" },
            "b": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000" },
            "xy": { ".validate": "newData.isString() && newData.val().length <= 24" },
            "f": { ".validate": "newData.isString() && newData.val().length <= 2" },
            "t": { ".validate": "newData.val() === now" },
            "$other": { ".validate": false }
          }
        },
        "inv": {
          "$to": {
            "$from": {
              ".write": "auth != null && (($from === auth.uid && (!newData.exists() || root.child('lob/' + $lid + '/p/' + auth.uid).exists())) || ($to === auth.uid && !newData.exists()))",
              ".validate": "newData.hasChildren(['c', 'n', 't'])",
              "c": { ".validate": "newData.isString() && newData.val().length <= 40" },
              "n": { ".validate": "newData.isString() && newData.val().length <= 16" },
              "cn": { ".validate": "newData.isString() && newData.val().length <= 20" },
              "t": { ".validate": "newData.val() === now" },
              "$other": { ".validate": false }
            }
          }
        },
        "cw": {
          "$cid": {
            ".write": "auth != null && ($cid === auth.uid || (!newData.exists() && !root.child('lob/' + $lid + '/p/' + $cid).exists()))",
            ".validate": "newData.hasChildren(['n'])",
            "n": { ".validate": "newData.isString() && newData.val().length <= 20" },
            "f": { ".validate": "newData.isString() && newData.val().length <= 12" },
            "$other": { ".validate": false }
          }
        },
        "$other": { ".validate": false }
      }
    },
    "rc": {
      "$k": {
        ".read": "auth != null && $k.matches(/^[A-Z0-9]{20,32}$/)",
        ".write": "auth != null && $k.matches(/^[A-Z0-9]{20,32}$/)",
        ".validate": "newData.hasChildren(['d', 't'])",
        "d": { ".validate": "newData.isString() && newData.val().length <= 400000" },
        "t": { ".validate": "newData.val() === now" },
        "$other": { ".validate": false }
      }
    }
  }
}
